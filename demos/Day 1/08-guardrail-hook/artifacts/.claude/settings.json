{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "dotnet run .claude/hooks/block-destructive.cs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "dotnet build BookTracker.sln --nologo -v q", "timeout": 120 }
        ]
      }
    ]
  }
}
